# Yaycay Admin - environment template. Copy to .env.local and fill in.
# When these are unset, the app runs against a local stub data layer (dev only).

# BE admin-scoped API base (the /admin/* endpoints)
NEXT_PUBLIC_API_BASE=

# Supabase admin client (same DB, admin/service-role scoped, server-side only)
ADMIN_SUPABASE_URL=
ADMIN_SERVICE_ROLE_KEY=

# Public Supabase values used by the browser auth client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Off-domain admin site URL (e.g. admin.yaycay-ops.* - never a product subdomain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dev-only escape hatch: when "true" and Supabase is not configured, a stub
# admin session is granted so screens can be developed without a live BE.
# MUST be unset/false in staging and production.
ADMIN_DEV_BYPASS=false
