# The shared contract package is private to the @alkazat org on GitHub Packages.
# Installing @alkazat/contracts requires a token with read:packages exposed as
# NODE_AUTH_TOKEN (CI: the Actions GITHUB_TOKEN with packages:read; Vercel: a
# PAT env var). With no @alkazat/* dependency present, this file is inert, so
# the normal build stays green until the package is actually added.
@alkazat:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
